---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import heroIllustration from "../assets/hero-pirate.png";
---

<Layout
  title="Galleon Tools"
  description="Set sail with Galleon Tools to Give your members access to your gated content in their OWN chat of choice &mdash; ChatGPT, Claude, and more."
>
  <main class="mx-auto max-w-7xl px-6 pt-24 lg:px-12 lg:pt-32">
    <h1 class="mb-6 font-brand text-3xl font-black text-orange-600">Galleon Tools</h1>
    <section
      class="mb-24 flex flex-col items-center gap-8 md:flex-row lg:gap-8"
    >
      <div class="max-w-2xl flex-1">
        <h1
          class="mb-6 text-5xl font-black leading-tight lg:text-6xl lg:leading-tight"
        >
          Your content, 
          <span
            class="inline-block bg-gradient-to-r from-orange-600 to-yellow-400 bg-clip-text text-transparent"
            > their chat.</span
          >
        </h1>
        <p
          class="mb-8 text-lg leading-relaxed text-gray-700 lg:text-2xl lg:leading-relaxed"
        >
          Give your <strong>members</strong> access to your gated content
          in their <strong>own</strong> chat of choice &mdash; ChatGPT, <strong>Claude</strong>, and more.
        </p>
      </div>
      <div class="max-w-lg flex-1">
        <Image
          src={heroIllustration}
          alt="Pirate character next to a browser window with skull icons"
          class="mx-auto w-full"
        />
      </div>
    </section>

    <section class="prose prose-lg dark:prose-invert">
      <h2 class="flex items-center gap-2">
        <span>🚧</span>
        <span>Work in Progress</span>
      </h2>

      <p>
        Galleon Tools isn't quite ready to leave the dock, but we'd love to hear 
        from you about what you're using to gate your content.
        And what ways you want your members to interact with it!
        <br />
        Don't look at the video below right now, it's just a placeholder.
      </p>

      <video
        src="/demos/chuck-demo-1.mp4"
        controls
        class="my-8 w-full rounded-lg shadow-lg"></video>

      <h2 class="flex items-center gap-2">
        <span>🏴‍☠️</span>
        <span>Interested in Galleon Tools?</span>
      </h2>

      <p>
        Join the voyage by signing up for the <a
          href="https://galleon.outseta.com/email/lists/7maReJQE/subscribe?registrationFieldConfiguration=%5B%7B%22defaultValue%22%3A%22%22%2C%22definition%22%3A%7B%22SystemName%22%3A%22Email%22%7D%2C%22hidden%22%3Afalse%2C%22required%22%3Atrue%7D%2C%7B%22defaultValue%22%3A%22%22%2C%22definition%22%3A%7B%22SystemName%22%3A%22FirstName%22%7D%2C%22hidden%22%3Afalse%2C%22required%22%3Afalse%7D%5D"
          class="text-blue-600 hover:text-blue-800 dark:text-blue-400 dark:hover:text-blue-200"
          >Galleon Gazette</a
        >!
      </p>

      <p>
        Got ideas or suggestions? ⚓ Drop me a message at <a
          href="mailto:queen@galleon.tools"
          class="text-blue-600 hover:text-blue-800 dark:text-blue-400 dark:hover:text-blue-200"
          >queen@galleon.tools</a
        >—I'd love to hear how Galleon Tools can work for you!
      </p>

      <div class="h-24"></div>
    </section>
  </main>
</Layout>
